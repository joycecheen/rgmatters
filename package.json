  "version": "1.0.0",
  "description": "Marketing site for Roentgen Matters (www.rgmatters.com)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
